# Trello credentials for the SDLC pipeline.
# install.py puts these in ~/.config/sdlc/.env (shared by all projects).
# A project can override them in <project>/.sdlc/.env, which is gitignored.
#
# Get both from your Power-Up's API key page at https://trello.com/power-ups/admin:
# the API key, and the token from the "Token" link (it starts with ATTA), not the Secret.
TRELLO_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token_starting_with_ATTA
